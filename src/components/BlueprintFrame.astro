---
type ClassValue = string | boolean | undefined | null;

interface Props {
  class?: ClassValue | ClassValue[];
  style?: string;
  corners?: boolean;
}

const { class: className = "", style, corners = false } = Astro.props;
---

<div class:list={["blueprint", className]} style={style}>
  {corners && (
    <>
      <i class="corner tl"></i>
      <i class="corner tr"></i>
      <i class="corner bl"></i>
      <i class="corner br"></i>
    </>
  )}
  <slot />
</div>
